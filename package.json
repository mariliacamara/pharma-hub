{
  "name": "pharma-hub",
  "description": "Integration hub for pharmacy stores: a shared core plus one module per integration.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "start:debug": "nest start --debug --watch",
    "build": "prisma generate && nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --concurrency=auto",
    "test": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests",
    "test:ci": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --ci",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --watch",
    "test:watchAll": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --watchAll",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --coverage",
    "test:int": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --config jest.int.config.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull && prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-node": "^30.5.1",
    "jest-mock-extended": "4.0.1",
    "msw": "^2.15.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  }
}
