# Copy to .env for local development. Never commit .env.
# In production (Railway) these are set in the service's variables, not in a file.

NODE_ENV=development
PORT=7000

# The running service connects as pharma_hub_app: not a superuser, not the
# owner of the tables. It refuses to start with a more privileged role,
# because such a role ignores the isolation between stores (decision 0016).
DATABASE_URL=postgresql://pharma_hub_app:app_dev_password@localhost:5432/pharma_hub

# The owner of the tables. Read only by the Prisma CLI (migrations and
# introspection), never by the running service.
DATABASE_MIGRATION_URL=postgresql://pharma_hub_owner:owner_dev_password@localhost:5432/pharma_hub

# The key that encrypts every store's credentials before they are stored.
# Format: <version>:<base64 of 32 random bytes>. Generate the second part with
#   openssl rand -base64 32
# Each environment has its own key. Without this exact value the stored
# credentials cannot be read again, so keep a copy somewhere safe.
# The value below is a placeholder for local development only.
CREDENTIALS_MASTER_KEY=1:bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1ub3QtYS1rZXk=

# Only while rotating the key: the older keys, comma-separated, so that
# credentials encrypted with them can still be read.
# CREDENTIALS_PREVIOUS_KEYS=

# The KuantoKusta Seller API. Production by default; to use the sandbox:
# KK_SELLER_API_BASE_URL=https://seller-sandbox.kuantokusta.pt/api
